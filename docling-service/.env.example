# Copy to .env (never commit .env). The secret encrypts every scan between
# the app and this scanner; put the same value in Vercel as DOCLING_SECRET.
# At least 32 characters. Generate one with:
#   openssl rand -hex 32        (macOS / Linux / Git Bash)
#   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")   (PowerShell)
DOCLING_SECRET=
# Largest upload accepted, in MB.
MAX_UPLOAD_MB=10
# Most PDF pages read per file.
MAX_PAGES=10
# Your static ngrok domain (ngrok dashboard, Domains), e.g. name.ngrok-free.app.
# run-scanner.bat starts ngrok with it; leave empty for a random address.
NGROK_URL=
# Authtoken of the ngrok account that owns NGROK_URL, when it is not the
# account in your default ngrok config (e.g. n8n uses that one). Dashboard,
# Your Authtoken. Leave empty to use the default config.
NGROK_AUTHTOKEN=

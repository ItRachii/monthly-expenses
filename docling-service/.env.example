# Copy to .env (never commit .env). Generate the key with:
#   openssl rand -hex 32        (macOS / Linux / Git Bash)
#   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")   (PowerShell)
DOCLING_API_KEY=
# Largest upload accepted, in MB.
MAX_UPLOAD_MB=10
# Most PDF pages read per file.
MAX_PAGES=10

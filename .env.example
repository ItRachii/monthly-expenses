# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Same DB the Streamlit app used — data carries over.
#
# Runtime uses Supabase's TRANSACTION pooler (port 6543). For Prisma you MUST
# keep `pgbouncer=true` — transaction pooling can't use prepared statements.
# The pooler username is  postgres.<PROJECT-REF>  (project ref is in the user).
# URL-encode the password (e.g. @ -> %40, # -> %23).
# Keep sslmode=require on both URLs — it forces TLS for data in transit.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Prisma migrations / `db pull` / `db push` need a DIRECT (non-pooled) connection.
# Use the SESSION pooler (port 5432) on the same host — it's IPv4-friendly,
# unlike the db.<ref>.supabase.co direct host (IPv6-only without the add-on).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me"

# Google OAuth client. Rotate the secret you pasted in chat before using it.
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxx"

# Public URL of the app. Locally http://localhost:3000, on Vercel your domain.
# Auth.js usually infers this on Vercel; set it explicitly if sign-in misbehaves.
AUTH_URL="http://localhost:3000"

# ── PII key for email addresses ──────────────────────────────────────────────
# Every table stores users as "u_…" ids (a keyed hash of the address) and the
# address only encrypted. This key makes both. Generate with:
#   openssl rand -base64 32
# Set the SAME value for Production and Preview on Vercel (they share the
# database) and keep a copy in a password manager. If it is lost or changed,
# existing users are not recognised at sign-in and stored addresses cannot be
# decrypted. Never rotate it without a re-keying migration.
PII_SECRET="replace-me"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Card statement import (/statements). On automatically in local development.
# In production it stays hidden until you set this to 1.
# STATEMENTS_ENABLED="1"

# ── Receipt scanner (Docling, docling-service/) ─────────────────────────────
# Receipts are read by the Docling scanner running on your own machine and
# reached through a tunnel such as ngrok. DOCLING_URL is its https address
# (no slash at the end); DOCLING_SECRET is the same value as DOCLING_SECRET
# in docling-service/.env. When either is missing, or the scanner is off, the
# app says scanning is not available.
DOCLING_URL=""
DOCLING_SECRET=""

# ── Push notifications (Web Push) ───────────────────────────────────────────
# Group activity as phone notifications, with the unread count on the app
# icon while the app is closed. Generate the pair once with:
#   npx web-push generate-vapid-keys
# Keep the same pair for Production and Preview: changing it stops every
# saved device from getting notifications until it opens the app again.
# VAPID_SUBJECT is a contact the push services can reach (mailto: or https:).
# When any of the three is missing, the app never offers notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@gmail.com"

# ── Developers ────────────────────────────────────────────────────────────────
# Sign-in addresses (comma-separated) that may open developer tools such as
# the scan inspector (/dev/scan) and product metrics (/dev/metrics). Everyone
# else gets a 404 there. Locally, when this is empty, every signed-in user
# counts as a developer.
DEVELOPER_EMAILS=""

# ── SMTP for group-invite emails (optional) ───────────────────────────────────
# Same Gmail app-password setup the Streamlit app used. Leave blank to skip email.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="you@gmail.com"
SMTP_PASSWORD="your gmail app password"
EMAIL_FROM="you@gmail.com"

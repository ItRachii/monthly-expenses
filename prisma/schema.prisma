// Prisma schema mapped onto the EXISTING Postgres tables created by the
// Streamlit/SQLAlchemy app (see legacy-streamlit/backend/models.py).
// Model fields are camelCase in code and @map to the real snake_case columns,
// so your existing data is read and written unchanged.
//
// After setting DATABASE_URL, verify the mapping against the live DB with:
//   npx prisma db pull        # introspect, then reconcile any differences
//   npx prisma generate       # regenerate the client

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Expense {
  id         Int      @id @default(autoincrement())
  date       DateTime @db.Date
  category   String
  item       String
  amount     Float
  payer      String
  split      String
  ownerEmail String?  @map("owner_email")
  groupId    String?  @map("group_id")
  group      Group?   @relation(fields: [groupId], references: [id])

  // Scanned-receipt line items: tagged with their receipt + optional per-item
  // GST. All nullable, so existing rows and every current query are unaffected.
  receiptId String?  @map("receipt_id")
  receipt   Receipt? @relation(fields: [receiptId], references: [id])
  gstRate   Float?   @map("gst_rate")
  gstAmount Float?   @map("gst_amount")

  // Unequal split: when split = "custom", each participant's share of the
  // amount as { userId: rupees }. Null for every other split.
  shares Json?

  // Several payers: when payer = "multiple", what each person put in as
  // { userId: rupees }, adding up to the amount. Null for a single payer.
  payers Json?

  // The card statement this expense was imported from, so the Statements
  // tab can list it under the statement. Null for hand-entered expenses.
  statementId Int?           @map("statement_id")
  statement   CardStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  // GST charges imported before the instalment they tax was on record.
  gstPending GstPending[]

  @@index([receiptId], map: "expenses_receipt_idx")
  @@index([statementId], map: "expenses_statement_idx")
  @@map("expenses")
}

// Header for a scanned receipt — the "main expense" its line items nest under.
// The receipt itself is not counted in money math; its line-item expense rows
// are, exactly like manually added expenses.
model Receipt {
  id          String    @id
  merchant    String    @default("")
  total       Float     @default(0)
  purchasedOn DateTime? @map("purchased_on") @db.Date
  ownerEmail  String?   @map("owner_email")
  groupId     String?   @map("group_id")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  expenses    Expense[]

  @@map("receipts")
}

model Settlement {
  id         Int      @id @default(autoincrement())
  month      String
  settledAt  DateTime @map("settled_at")
  settledBy  String   @map("settled_by")
  /**
   * Who received the payment. Null on rows recorded before partial payments.
   */
  settledTo  String?  @map("settled_to")
  amount     Float
  note       String?
  ownerEmail String?  @map("owner_email")
  groupId    String?  @map("group_id")
  group      Group?   @relation(fields: [groupId], references: [id])

  @@map("settlements")
}

// PII: `email` holds the user id ("u_" + keyed hash of the address), never the
// address itself. The address is only in email_enc, AES-256-GCM encrypted.
// The same applies to every other *email / payer / split / *_by column.
model AppUser {
  email      String  @id
  emailEnc   String? @map("email_enc")
  firstName  String  @map("first_name")
  lastName   String? @map("last_name")
  /**
   * Google profile photo URL, refreshed on sign-in; shown in place of names.
   */
  image      String?
  /**
   * Legacy nickname column; no longer read (see db/2026_09_app_users_last_name.sql).
   */
  username   String?
  systemRole String  @map("system_role")

  /**
   * Income popup state: "onboarding" (new user, ask before anything else),
   * "later" (remind on next sign-in), "skipped", or null (existing user not
   * asked yet). Ignored once an income is set.
   */
  incomePrompt   String?   @map("income_prompt")
  /**
   * When "later" or "skipped" was chosen.
   */
  incomePromptAt DateTime? @map("income_prompt_at")
  lastSignInAt   DateTime? @map("last_sign_in_at")

  @@map("app_users")
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  inviteCode  String?  @map("invite_code")
  createdBy   String   @map("created_by")
  createdAt   DateTime @map("created_at")
  active      Int      @default(1)

  members       GroupMember[]
  invites       GroupInvite[]
  expenses      Expense[]
  settlements   Settlement[]
  notifications Notification[]
  nameHistory   GroupNameHistory[]

  @@map("groups")
}

// SCD Type 2 history of a group's name. `groups.name` always holds the
// current name; every rename closes the open row (sets valid_to) and opens a
// new one, so old names and the exact period each was in use are preserved.
model GroupNameHistory {
  id        Int       @id @default(autoincrement())
  groupId   String    @map("group_id")
  name      String
  validFrom DateTime  @map("valid_from")
  validTo   DateTime? @map("valid_to")
  changedBy String    @map("changed_by")
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, validFrom(sort: Desc)], map: "group_name_history_group_idx")
  @@map("group_name_history")
}

model GroupMember {
  id            Int       @id @default(autoincrement())
  groupId       String    @map("group_id")
  email         String
  displayName   String?   @map("display_name")
  role          String?
  joinedAt      DateTime  @map("joined_at")
  /// When this member last opened the group, for the sidebar's recent groups.
  lastVisitedAt DateTime? @map("last_visited_at") @db.Timestamptz(6)
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([email, lastVisitedAt(sort: Desc)], map: "group_members_email_visit_idx")
  @@map("group_members")
}

model GroupInvite {
  id              Int       @id @default(autoincrement())
  groupId         String    @map("group_id")
  invitedEmail    String    @map("invited_email")
  /**
   * Encrypted address, so the invite can still be shown masked.
   */
  invitedEmailEnc String?   @map("invited_email_enc")
  invitedBy       String    @map("invited_by")
  status          String    @default("pending")
  createdAt       DateTime  @map("created_at")
  respondedAt     DateTime? @map("responded_at")
  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_invites")
}

model Notification {
  id             Int      @id @default(autoincrement())
  recipientEmail String   @map("recipient_email")
  groupId        String   @map("group_id")
  actorEmail     String   @map("actor_email")
  type           String
  message        String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([recipientEmail, isRead, createdAt(sort: Desc)], map: "notifications_recipient_idx")
  @@map("notifications")
}

// Fixed monthly income, one row per month it changed. The amount for a month
// is the row with the latest effective_month on or before it (the earliest
// row also covers months before it), so a raise never rewrites old savings.
model UserIncome {
  userEmail      String   @map("user_email")
  /**
   * YYYY-MM the amount applies from.
   */
  effectiveMonth String   @map("effective_month")
  amount         Float
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([userEmail, effectiveMonth])
  @@map("user_incomes")
}

// Records one-time data migrations run by the app (see src/lib/piiMigration.ts).
model PiiMigration {
  id        String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("pii_migrations")
}

// A credit card the user has imported statements for. Identified by the last
// four digits only: no more of the number is ever stored.
model Card {
  id          String          @id @default(uuid())
  ownerEmail  String          @map("owner_email")
  bank        String
  last4       String
  product     String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  statements  CardStatement[]
  instalments EmiInstalment[]

  @@unique([ownerEmail, bank, last4], map: "cards_owner_bank_last4_key")
  @@map("cards")
}

// One statement's summary box for a card. Money figures only; no lines.
model CardStatement {
  id                 Int       @id @default(autoincrement())
  cardId             String    @map("card_id")
  /**
   * YYYY-MM the statement is for.
   */
  period             String
  statementDate      DateTime? @map("statement_date") @db.Date
  dueDate            DateTime? @map("due_date") @db.Date
  previousDues       Float?    @map("previous_dues")
  paymentsCredits    Float?    @map("payments_credits")
  purchases          Float?
  financeCharges     Float?    @map("finance_charges")
  totalDue           Float?    @map("total_due")
  minimumDue         Float?    @map("minimum_due")
  creditLimit        Float?    @map("credit_limit")
  availableCredit    Float?    @map("available_credit")
  availableCash      Float?    @map("available_cash")
  domesticTotal      Float?    @map("domestic_total")
  internationalTotal Float?    @map("international_total")
  emiTotal           Float?    @map("emi_total")
  importedAt         DateTime  @default(now()) @map("imported_at") @db.Timestamptz(6)
  card               Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  expenses           Expense[]

  @@unique([cardId, period], map: "card_statements_card_period_key")
  @@map("card_statements")
}

// One EMI instalment as a statement billed it, so the GST that HDFC bills a
// month later can be traced back to it. The loan is known by a keyed hash
// computed in the browser and its last four digits; the number itself is
// never stored.
model EmiInstalment {
  id           Int      @id @default(autoincrement())
  ownerEmail   String   @map("owner_email")
  cardId       String?  @map("card_id")
  loanKey      String   @map("loan_key")
  loanLast4    String?  @map("loan_last4")
  instalmentNo Int?     @map("instalment_no")
  date         DateTime @db.Date
  principal    Float
  interest     Float
  refKey       String?  @map("ref_key")
  /**
   * GST on the interest, once a statement billed it.
   */
  gst          Float?
  /**
   * Statement month that billed the GST.
   */
  gstPeriod    String?  @map("gst_period")
  /**
   * Statement month that billed the instalment.
   */
  period       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  card         Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@unique([ownerEmail, loanKey, date], map: "emi_instalments_owner_loan_date_key")
  @@index([ownerEmail, loanKey], map: "emi_instalments_owner_loan_idx")
  @@index([ownerEmail, refKey], map: "emi_instalments_owner_ref_idx")
  @@map("emi_instalments")
}

// A GST charge imported before the instalment it taxes was on record. The
// cited reference's keyed hash is kept so that, once the earlier statement
// is uploaded, the charge is traced to its instalment, the expense renamed
// and the warning on it cleared.
model GstPending {
  id                   Int       @id @default(autoincrement())
  ownerEmail           String    @map("owner_email")
  expenseId            Int       @map("expense_id")
  refKey               String    @map("ref_key")
  amount               Float
  date                 DateTime  @db.Date
  /**
   * Statement month that billed the GST.
   */
  period               String
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedInstalmentId Int?      @map("resolved_instalment_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expense              Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([ownerEmail, refKey], map: "gst_pending_owner_ref_idx")
  @@index([expenseId], map: "gst_pending_expense_idx")
  @@map("gst_pending")
}
